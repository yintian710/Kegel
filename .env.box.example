# 测试环境（同域名子路径 /box）示例配置
# 用法：复制为独立的 .env.box（不要与生产 .env 混用），启动测试后端时加载它。
# 原则：同一域名、独立端口、独立数据库、独立密钥；Cookie 通过路径 /box 与主站隔离。

# ── 网络与数据库 ──
HOST=127.0.0.1
# 测试后端新端口（生产默认 7188，这里用 7190）。
PORT=7190
# 对外 Origin（只写 scheme://host[:port]，不要带 /box 路径）。
# 因为同一域名，POST 的 Origin 校验（Origin == APP_BASE_URL）与生产共用同一个 Origin。
APP_BASE_URL=https://your-domain.example
# 前端挂载子路径前缀，必须以 / 开头和结尾。
FRONTEND_BASE_PATH=/box/
# 独立测试库，避免污染生产数据。
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kegel_box
# 测试实例用不同的 worker id（0–1023，与生产及其他实例都不相同）。
SNOWFLAKE_WORKER_ID=1

# ── 密钥与管理 ──
# 必须与生产不同；生产要求 >= 32 字符。生成：openssl rand -base64 48
APP_SECRET=
# 测试环境固定登录（不走 OAuth）：直接以该用户进入；ADMIN_USER_IDS 需包含此 ID 才能进管理后台。
AUTO_LOGIN_ENABLED=true
AUTO_LOGIN_USER_ID=1
AUTO_LOGIN_USERNAME=yintian
AUTO_LOGIN_NAME=yintian
ADMIN_USER_IDS=1
ADMIN_SECONDARY_PASSWORD=
ADMIN_POINTS_PASSWORD_HASH=

# ── LINUX DO Connect（登录）──
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# 关键：测试环境回调必须带 /box 前缀，并在 LINUX DO Connect 应用后台登记该回调地址。
LINUXDO_REDIRECT_URI=https://your-domain.example/box/api/auth/linuxdo/callback

# ── LDC（建议测试环境关闭真实发货/赞助）──
LDC_DONATION_ENABLED=false
LDC_LIVE=false
LDC_API_BASE=https://credit.linux.do
LDC_CLIENT_ID=
LDC_CLIENT_SECRET=
DAILY_LDC_LIMIT=800
DAILY_DISCOUNT_SAVE_CAP=500
PAYMENT_LOG_PATH=/opt/kegel-box/checkin.payments.jsonl

# ── 自动化 ──
CHECKIN_TRIGGER_TOKEN=
CHECKIN_CONDITION_TOKEN=
