# 本文件可提交；复制为 .env 后填写。切勿提交真实密钥。
# 只读环境变量（已有进程环境变量优先于 .env）。非法配置启动即报错。

# ── 网络与数据库 ──
HOST=127.0.0.1
PORT=7188
# 对外完整地址；生产必须 HTTPS。POST 请求的 Origin 必须等于它。
APP_BASE_URL=http://localhost:7188
# 前端挂载的路径前缀，默认 / （站点根路径）；若前端托管在子路径需同时修改 frontend/vite.config.ts 的 base。
FRONTEND_BASE_PATH=/
# PostgreSQL 连接串。表结构由 sql/schema.sql 手动执行，应用不自动建表。
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kegel
# 雪花 ID 机器号（0–1023）。生产实例必须显式设置，多实例各不相同。
SNOWFLAKE_WORKER_ID=0

# ── 密钥与管理 ──
# 生产必须填写至少 32 字符的随机值；本地留空则每次启动随机生成（重启使旧会话失效）。
APP_SECRET=
# 管理员的 LINUX DO 用户 ID（纯数字，逗号分隔）；只有这些账号登录后能访问管理后台，留空则无人可进。
ADMIN_USER_IDS=
# 管理员敏感操作二级密码（修改排名奖励、商品上架/编辑/下架、人工加积分）。二选一：
ADMIN_SECONDARY_PASSWORD=
# 或 PBKDF2 加盐哈希：pbkdf2_sha256$600000$<32位十六进制盐>$<64位十六进制摘要>；生成命令见 docs/deployment.md
ADMIN_POINTS_PASSWORD_HASH=

# ── LINUX DO Connect（登录）──
# 回调地址已迁移为 /api/auth/linuxdo/callback，需同步修改 Connect 应用后台。
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=http://localhost:7188/api/auth/linuxdo/callback

# ── LINUX DO Credit（商品自动发货与赞助）──
# 赞助默认关闭；启用且凭据、HTTPS 地址有效时才可创建订单。赞助不增加站内积分。
# 商户通知地址填写 APP_BASE_URL + /api/payments/ldc/notify
LDC_DONATION_ENABLED=false
# 商品兑换真实发货；false 为模拟发货。
LDC_LIVE=false
LDC_API_BASE=https://credit.linux.do
LDC_CLIENT_ID=
LDC_CLIENT_SECRET=
# 全站每日 LDC 兑换总额度（整数 LDC），0 停止兑换；不影响签到积分。修改后重启生效。
DAILY_LDC_LIMIT=800
# LDC 折扣每日节省上限（积分/人/天）。拥有 UR（discount_bp<10000）兑换 LDC 时生效；0 表示不打折。
DAILY_DISCOUNT_SAVE_CAP=500
# 支付请求/响应/回调对账日志（UTF-8 JSONL，追加，不轮转）；留空为项目根目录 checkin.payments.jsonl。
PAYMENT_LOG_PATH=

# ── 自动化 ──
# 外部 POST /api/trigger/open 使用 X-Trigger-Token；留空禁用该入口。
CHECKIN_TRIGGER_TOKEN=
# 可选 condition_url 的 Bearer 凭据；URL 在管理设置中配置。
CHECKIN_CONDITION_TOKEN=
