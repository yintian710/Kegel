# 本文件可提交；复制为 .env 后填写。切勿提交真实密钥。
# Python 内置 .env 加载；已有进程环境变量优先。
CHECKIN_DB=checkin.db
# 支付请求、响应及回调日志，默认在数据库同目录生成 <数据库名>.payments.jsonl。
# UTF-8 追加保存，不截断业务响应、不自动删除；认证凭据、Cookie、签名脱敏。
PAYMENT_LOG_PATH=
HOST=127.0.0.1
PORT=8000
APP_BASE_URL=http://localhost:8000
# 全站每日 LDC 兑换总额度（整数 LDC），0 停止兑换；不影响签到积分。修改后重启生效。
DAILY_LDC_LIMIT=800
# 生产必须填写至少 32 字符的随机值；本地留空则每次启动随机生成。
APP_SECRET=
# 留空会拒绝所有管理接口访问。
ADMIN_TOKEN=
# 管理员敏感操作二级密码（修改排名奖励、商品上架/编辑/下架、人工加积分时校验）。
# 支持两种配置方式之一：
# 方式一：直接配置明文二级密码（适合便捷配置）：
ADMIN_SECONDARY_PASSWORD=
# 方式二：配置 PBKDF2 加盐哈希（安全性更高，留空则使用方式一）：
# 格式 pbkdf2_sha256$600000$<32位十六进制盐>$<64位十六进制摘要>；生成命令见 docs/deployment.md。
ADMIN_POINTS_PASSWORD_HASH=

# 必须配置 OAuth 才能登录签到；没有演示身份。
# 两项凭据均填写后，进站先登录；登录状态有效期 5 天，访问时自动续期。
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=http://localhost:8000/auth/linuxdo/callback

# 可选：使用官方 LDC 商户 API Key（Client ID / Client Secret）验证真实赞助。
# 默认关闭；启用且凭据、HTTPS 地址有效时才可创建订单。赞助不增加站内积分。
# 商户通知地址填写 APP_BASE_URL + /payments/ldc/notify；异步验签结算后进入赞助榜。
# 生产地址必须 HTTPS；仅本地 localhost/127.0.0.1 允许 HTTP。
LDC_DONATION_ENABLED=false
LDC_API_BASE=https://credit.linux.do
LDC_CLIENT_ID=
LDC_CLIENT_SECRET=

# 外部 POST /api/trigger/open 使用 X-Trigger-Token；留空禁用该入口。
CHECKIN_TRIGGER_TOKEN=
# 可选 condition_url 的 Bearer 凭据；URL 在管理设置中配置。
CHECKIN_CONDITION_TOKEN=
